@model Portfolio_Personal.Models.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Hernan Nequi - Portfolio Analista Programador";
}

<!-- Dark/Light Switch fijo arriba a la derecha -->
<div class="form-check form-switch theme-switch position-fixed top-0 end-0 m-3 z-3">
    <input class="form-check-input" type="checkbox" id="themeToggle" checked>
    <label class="form-check-label" for="themeToggle"><i class="bi bi-sun-fill"></i></label>
</div>

<!-- Layout principal -->
<div class="layout-wrapper d-flex">

    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="d-flex align-items-center">
                <div class="bg-primary text-white d-flex align-items-center justify-content-center rounded me-3" style="width:3rem; height:3rem;">
                    <strong>H</strong>
                </div>
                <div>
                    <h5 class="mb-0">Mi Portfolio</h5>
                </div>
            </div>
        </div>

        <nav class="nav flex-column">
            <a href="#hero" class="nav-link">Sobre Mi</a>
            <a href="#experience" class="nav-link">Experiencia</a>
            <a href="#projects" class="nav-link">Proyectos</a>
            <a href="#studies" class="nav-link">Formacion y Capacitaciones</a>
            <a href="#contact" class="nav-link">Contacto</a>
        </nav>

        <div class="d-flex gap-3 mt-4">
            <a href="https://www.linkedin.com/in/hernan-nequi/" target="_blank"><i class="bi bi-linkedin fs-4"></i></a>
            <a href="https://github.com/hernannequi" target="_blank"><i class="bi bi-github fs-4"></i></a>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="main-content flex-grow-1">
        <!-- Hero -->
        <section id="hero" class="d-flex flex-column justify-content-center py-5">
            <p class="text-secondary">Hola, soy Hernan,</p>
            <h1 class="display-4 fw-bold">Analista Programador</h1>
            <div class="row align-items-center">
                <div class="col-md-4 text-center mb-4 mb-md-0">
                    <img src="@Url.Content("~/img/foto.png")" class="rounded-circle img-fluid" style="max-width:180px; height:auto;" />
                    @*  <div class="video-presentacion mx-auto">
                        <video width="320" height="240" style="max-width:100%;" controls>
                            <source src="@Url.Content("~/video/presentacion.mp4")" type="video/mp4" />
                            Tu navegador no soporta el video.
                        </video>
                    </div> *@
                </div>
                <div class="col-md-8">
                    <p class="text-secondary mt-3">
                        Analista Programador de Argentina, especializado en integraciones, SQL Server y tecnologías .NET. Con experiencia en análisis de requerimientos, soporte operativo y automatización de procesos entre ERP, sistemas logísticos y plataformas e-commerce, combinando perfil técnico con capacidad para comprender necesidades de negocio y acompañar usuarios.
                    </p>
                </div>
            </div>

            <div class="d-flex justify-content-center gap-3 mt-4 flex-wrap">

                <a href="#contact"
                   class="btn btn-primary px-4 py-2">
                    Contactame!
                </a>

                <a href="~/files/CV-Hernan-Nequi-Analista-Programador.pdf"
                   class="btn btn-outline-primary px-4 py-2"
                   download
                   asp-append-version="true">

                    <i class="bi bi-download me-2"></i>
                    Descargar CV
                </a>

            </div>
        </section>

        <!-- Experience -->
        <section id="experience" class="py-5">
            <h2 class="fw-bold mb-4">Experiencia Laboral</h2>
            @foreach (var experienciaLaboral in Model.ExperienciasLaborales)
            {
                <div class="timeline position-relative">
                    <div class="position-relative">
                        <div class="timeline-dot"></div>
                        <h5>&nbsp @experienciaLaboral.Rol</h5>
                        @if (!string.IsNullOrEmpty(experienciaLaboral.UrlEmpresa))
                        {
                            <a href="@experienciaLaboral.UrlEmpresa" target="_blank" class="text-secondary">
                                @experienciaLaboral.Empresa
                            </a>
                            <span class="text-secondary"> | @experienciaLaboral.FechaInicioFinEmpleo</span>

                        }
                        else
                        {
                            <small class="text-secondary">@experienciaLaboral.Empresa | @experienciaLaboral.FechaInicioFinEmpleo</small>
                        }
                        <p class="text-secondary mt-2">@experienciaLaboral.Descripcion</p>
                    </div>
                </div>
            }
        </section>

        <!-- Projects -->
        <section id="projects" class="py-5">
            <h2 class="fw-bold mb-4">Proyectos</h2>

            <div id="projectsCarousel" class="carousel slide" data-bs-ride="carousel">

                <div class="carousel-inner">

                    <!-- Slide 1 -->
                    <div class="carousel-item active">
                        <div class="row g-4">

                            <!-- Cards -->
                            @foreach (var proyecto in Model.Proyectos)
                            {
                                <div class="col-md-4">
                                    <div class="card h-100 shadow-sm bg-body-tertiary border-0">
                                        @if(!string.IsNullOrEmpty(proyecto.Imagen))
                                        {
                                        <img src="@proyecto.Imagen"
                                             class="card-img-top"
                                             alt="@proyecto.Titulo">
                                        }
                                        else
                                        {
                                            <img src="https://picsum.photos/600/400?1"
                                                 class="card-img-top"
                                                 alt="@proyecto.Titulo">
                                        }
                                        <div class="card-body text-body">
                                            <h5 class="card-title">@proyecto.Titulo</h5>
                                            <p class="card-text">
                                                @proyecto.Descripcion
                                            </p>
                                        </div>

                                        <ul class="list-group bg-body text-body">
                                            @foreach (var tecnologia in proyecto.Tecnologias)
                                            {
                                                <li class="list-group-item bg-body text-body">
                                                    @tecnologia
                                                </li>
                                            }
                                        </ul>

                                        <div class="card-body text-body">
                                            @if (!string.IsNullOrEmpty(proyecto.GithubUrl))
                                            {
                                                <a href="@proyecto.GithubUrl" class="card-link">
                                                    GitHub
                                                </a>
                                            }
                                            @if (!string.IsNullOrEmpty(proyecto.DemoUrl))
                                            {
                                                <a href="@proyecto.DemoUrl" class="card-link">
                                                    Demo
                                                </a>
                                            }
                                        </div>

                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Controles -->

                <button class="carousel-control-prev"
                        type="button"
                        data-bs-target="#projectsCarousel"
                        data-bs-slide="prev">

                    <span class="carousel-control-prev-icon"></span>

                </button>

                <button class="carousel-control-next"
                        type="button"
                        data-bs-target="#projectsCarousel"
                        data-bs-slide="next">

                    <span class="carousel-control-next-icon"></span>

                </button>

            </div>
        </section>

        <!-- Studies-->
        <section id="studies" class="py-5">
            <h2 class="fw-bold mb-4">Formacion y Capacitaciones</h2>
            @foreach (var formacion in Model.FormacionesAcademicas)
            {
                <div class="timeline position-relative">
                    <div class="position-relative mb-4">
                        <div class="timeline-dot"></div>
                        <h5>
                            <strong>
                                &nbsp
                                @if (!string.IsNullOrEmpty(formacion.UrlInstituto))
                                {
                                    <a href="@formacion.UrlInstituto"
                                       target="_blank"
                                       class="text-decoration-none text-reset">
                                        @formacion.Titulo
                                    </a>
                                }
                                else
                                {
                                    @formacion.Titulo
                                }

                            </strong>
                            <br>

                            <small class="text-secondary">
                                @formacion.Institucion |
                                @formacion.FechaInicioFinCursada
                            </small>
                        </h5>
                        @if (!string.IsNullOrEmpty(formacion.Descripcion))
                        {
                            <p class="text-secondary mt-2">
                                @formacion.Descripcion
                            </p>
                        }


                        @if (!string.IsNullOrEmpty(formacion.UrlCertificado))
                        {
                            <a href="@Url.Content(formacion.UrlCertificado)"
                               class="text-secondary"
                               target="_blank">
                                Ver Certificado
                            </a>
                        }
                    </div>
                </div>
            }
        </section>

        <!-- Contact -->
        <section id="contact" class="py-5">
            <h2 class="fw-bold text-center mb-3">Pongamonos en contacto</h2>
            <p class="text-secondary text-center mb-5">¿Tenes algún proyecto en mente?</p>

            <form id="contactForm"
                  asp-action="EnviarContacto"
                  method="post"
                  class="mx-auto"
                  style="max-width:600px;">

                <div class="mb-3">
                    <label asp-for="Contacto.Nombre" class="form-label"></label>
                    <input asp-for="Contacto.Nombre" class="form-control" placeholder="Nombre y Apellido" />
                    <span asp-validation-for="Contacto.Nombre" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Contacto.Email" class="form-label"></label>
                    <input asp-for="Contacto.Email" class="form-control" placeholder="email@ejemplo.com" />
                    <span asp-validation-for="Contacto.Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Contacto.Mensaje" class="form-label"></label>
                    <textarea asp-for="Contacto.Mensaje" class="form-control" rows="4" placeholder="Escribi tu mensaje..."></textarea>
                    <span asp-validation-for="Contacto.Mensaje"
                          class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-center">
                    <button type="submit"
                            id="submitButton"
                            class="btn btn-primary px-5 py-2 w-100 rounded-pill shadow-sm"
                            style="max-width:300px;">
                        Enviar mensaje
                    </button>
                </div>

            </form>
        </section>

        <!-- Botón flotante "Volver arriba" -->
        <button type="button" class="btn btn-primary btn-lg rounded-circle" id="btnScrollTop">
            <i class="bi bi-arrow-up"></i>
        </button>

    </main>

    <!-- Modal -->
    <div class="modal fade"
         id="responseModal"
         tabindex="-1"
         aria-labelledby="responseModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title"
                        id="responseModalLabel">
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>

                </div>

                <div class="modal-body text-center">

                    <i id="responseIcon"
                       class="fs-1">
                    </i>

                    <p id="responseMessage"
                       class="mt-3">
                    </p>

                </div>

            </div>
        </div>
    </div>
</div>


@section Scripts {

    <script>

        document.addEventListener('DOMContentLoaded', function () {

            // =========================
            // Theme toggle
            // =========================

            const themeToggle = document.getElementById("themeToggle");
            const htmlElement = document.documentElement;

            if (themeToggle) {

                if (localStorage.getItem("theme") === "dark") {

                    htmlElement.setAttribute("data-bs-theme", "dark");
                    themeToggle.checked = false;

                } else {

                    htmlElement.setAttribute("data-bs-theme", "light");
                    themeToggle.checked = true;
                }

                themeToggle.addEventListener("change", function () {

                    if (this.checked) {

                        htmlElement.setAttribute("data-bs-theme", "light");
                        localStorage.setItem("theme", "light");

                    } else {

                        htmlElement.setAttribute("data-bs-theme", "dark");
                        localStorage.setItem("theme", "dark");
                    }
                });
            }

            // =========================
            // Scroll top button
            // =========================

            const btnScrollTop = document.getElementById('btnScrollTop');

            if (btnScrollTop) {

                const SHOW_AFTER = 300;

                const toggleScrollBtn = () => {

                    if (window.scrollY > SHOW_AFTER) {
                        btnScrollTop.classList.add('show');
                    }
                    else {
                        btnScrollTop.classList.remove('show');
                    }
                };

                toggleScrollBtn();

                window.addEventListener('scroll', toggleScrollBtn, { passive: true });

                btnScrollTop.addEventListener('click', function () {

                    window.scrollTo({
                        top: 0,
                        behavior: 'smooth'
                    });

                });
            }

            // =========================
            // Modal contacto
            // =========================

            const modalElement = document.getElementById('responseModal');
            const form = document.getElementById('contactForm');
            const submitButton = document.getElementById('submitButton');

            if (form && submitButton) {

                form.addEventListener('submit', function () {

                    submitButton.disabled = true;

                    submitButton.innerHTML = `
                        <span class="spinner-border spinner-border-sm"></span>
                        Enviando...
                    `;
                });
            }

            if (modalElement) {

                const modal = new bootstrap.Modal(modalElement);

                const modalTitle = document.getElementById('responseModalLabel');
                const modalIcon = document.getElementById('responseIcon');
                const modalMessage = document.getElementById('responseMessage');

                        const successMessage = `@TempData["Success"]`;
                        const errorMessage = `@TempData["Error"]`;

                if (successMessage && successMessage.trim() !== '') {

                    modalTitle.textContent = '¡Mensaje enviado!';
                    modalIcon.className = 'bi bi-check-circle text-success fs-1';
                    modalMessage.textContent = successMessage;

                    modal.show();

                    setTimeout(() => {
                        modal.hide();
                    }, 3000);

                }

                if (errorMessage && errorMessage.trim() !== '') {

                    modalTitle.textContent = 'Error al enviar';
                    modalIcon.className = 'bi bi-x-circle text-danger fs-1';
                    modalMessage.textContent = errorMessage;

                    modal.show();

                    setTimeout(() => {
                        modal.hide();
                    }, 4000);
                }
            }

        });

    </script>
    <partial name="_ValidationScriptsPartial" />
}